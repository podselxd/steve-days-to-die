<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SteveDaysToDie</AssemblyName>
    <RootNamespace>SteveDaysToDie</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <LangVersion>10</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Release\</OutputPath>
    <Configuration>Release</Configuration>
  </PropertyGroup>

  <!-- the launcher (SteveVsZombies.exe) is its own project -->
  <ItemGroup>
    <Compile Remove="launcher/**" />
    <EmbeddedResource Remove="launcher/**" />
    <None Remove="launcher/**" />
  </ItemGroup>

  <!-- 7 Days to Die game references — not shipped with the mod -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GAME7DTD)\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
