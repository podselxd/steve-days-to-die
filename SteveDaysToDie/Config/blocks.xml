<configs>
    <!-- V1: Stone yields cobblestone when mined with pickaxe (Minecraft behavior).
         Original drop was resourceRockSmall x55 — changed to resourceCobblestones 1-4. -->
    <set xpath="/blocks/block[@name='terrStone']/drop[@event='Harvest']/@name">resourceCobblestones</set>
    <set xpath="/blocks/block[@name='terrStone']/drop[@event='Harvest']/@count">1,4</set>

    <!-- Coal ore already drops resourceCoal — no change needed.                   -->
    <!-- Iron ore already drops resourceScrapIron (iron nugget equiv) — no change. -->
    <!-- Dirt already drops resourceClayLump (clay ball equiv) — no change.        -->
    <!-- Minecraft's crafting table: a real block (src/Crafting/McStations.cs). Looks like Minecraft's via the mod. -->
    <append xpath="/blocks">
        <block name="mc_crafting_table">
            <property name="Class" value="McCraftingTable, SteveDaysToDie"/>
            <property name="Material" value="Mwood_weak"/>
            <property name="Texture" value="241"/>
            <property name="CustomIcon" value="mc_crafting_table"/>
            <property name="CustomIconTint" value="ffffff"/>
            <property name="CreativeMode" value="Player"/>
            <property name="Group" value="Building,Minecraft"/>
            <property name="DescriptionKey" value="mcItemDesc"/>
            <property name="Stacknumber" value="64"/>
            <property name="EconomicValue" value="1"/>
            <drop event="Destroy" name="mc_crafting_table" count="1"/>
        </block>
        <block name="mc_furnace">
            <property name="Class" value="McFurnace, SteveDaysToDie"/>
            <property name="Material" value="Mstone"/>
            <property name="Texture" value="1"/>
            <property name="CustomIcon" value="mc_furnace"/>
            <property name="CustomIconTint" value="ffffff"/>
            <property name="CreativeMode" value="Player"/>
            <property name="Group" value="Building,Minecraft"/>
            <property name="DescriptionKey" value="mcItemDesc"/>
            <property name="Stacknumber" value="64"/>
            <property name="EconomicValue" value="1"/>
            <drop event="Destroy" name="mc_furnace" count="1"/>
        </block>
        <block name="mc_smoker">
            <property name="Class" value="McFurnace, SteveDaysToDie"/>
            <property name="Material" value="Mstone"/>
            <property name="Texture" value="1"/>
            <property name="CustomIcon" value="mc_smoker"/>
            <property name="CustomIconTint" value="ffffff"/>
            <property name="CreativeMode" value="Player"/>
            <property name="Group" value="Building,Minecraft"/>
            <property name="DescriptionKey" value="mcItemDesc"/>
            <property name="Stacknumber" value="64"/>
            <property name="EconomicValue" value="1"/>
            <drop event="Destroy" name="mc_smoker" count="1"/>
        </block>
        <block name="mc_blast_furnace">
            <property name="Class" value="McFurnace, SteveDaysToDie"/>
            <property name="Material" value="Mstone"/>
            <property name="Texture" value="1"/>
            <property name="CustomIcon" value="mc_blast_furnace"/>
            <property name="CustomIconTint" value="ffffff"/>
            <property name="CreativeMode" value="Player"/>
            <property name="Group" value="Building,Minecraft"/>
            <property name="DescriptionKey" value="mcItemDesc"/>
            <property name="Stacknumber" value="64"/>
            <property name="EconomicValue" value="1"/>
            <drop event="Destroy" name="mc_blast_furnace" count="1"/>
        </block>
    </append>
</configs>
