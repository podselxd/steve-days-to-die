<configs>
    <!-- GENERATED by tools/build_config.py from sheets/survival.json: Minecraft's jump height (1.25 blocks). -->
    <set xpath="/entity_classes/entity_class[@name='playerMale']//passive_effect[@name='JumpStrength' and @value='0.16']/@value">0.152</set>
    <set xpath="/entity_classes/entity_class[@name='playerMale']//passive_effect[@name='JumpStrength' and @tags='crouching']/@value">0.152</set>
    <!-- GENERATED from sheets/mc_animals.json: Minecraft's animals (body, AI and health of a 7 Days animal that flees;
         Minecraft's look is drawn by src/Mobs/McAnimal.cs). Skinning them gives Minecraft's food. -->
    <append xpath="/entity_classes">
        <entity_class name="mcCow" extends="animalDoe">
            <property name="Tags" value="entity,animal,minecraft,mccow"/>
            <property name="UserSpawnType" value="Menu"/>
            <drop event="Harvest" name="mc_beef" count="3" tag="allHarvest"/>
            <drop event="Harvest" name="mc_leather" count="2" tag="allHarvest"/>
        </entity_class>
        <entity_class name="mcPig" extends="animalDoe">
            <property name="Tags" value="entity,animal,minecraft,mcpig"/>
            <property name="UserSpawnType" value="Menu"/>
            <drop event="Harvest" name="mc_porkchop" count="3" tag="allHarvest"/>
        </entity_class>
        <entity_class name="mcSheep" extends="animalDoe">
            <property name="Tags" value="entity,animal,minecraft,mcsheep"/>
            <property name="UserSpawnType" value="Menu"/>
            <drop event="Harvest" name="mc_mutton" count="2" tag="allHarvest"/>
            <drop event="Harvest" name="mc_white_wool" count="1" tag="allHarvest"/>
        </entity_class>
        <entity_class name="mcChicken" extends="animalChicken">
            <property name="Tags" value="entity,animal,minecraft,mcchicken"/>
            <property name="UserSpawnType" value="Menu"/>
            <drop event="Harvest" name="mc_chicken" count="1" tag="allHarvest"/>
            <drop event="Harvest" name="mc_feather" count="2" tag="allHarvest"/>
        </entity_class>
        <entity_class name="mcCreeper" extends="zombieBoe">
            <property name="UserSpawnType" value="Menu"/>
            <drop event="Harvest" name="mc_gunpowder" count="2" tag="allHarvest"/>
        </entity_class>
    </append>
</configs>
